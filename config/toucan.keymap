#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#include "key-labels/42.h"
#define KEYS_L LT0 LT1 LT2 LT3 LT4 LT5 LM0 LM1 LM2 LM3 LM4 LM5 LB0 LB1 LB2 LB3 LB4 LB5 // Left-hand keys.
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RT5 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5 // Right-hand keys.
#define THUMBS LH2 LH1 LH0 RH0 RH1 RH2                                                 // Thumb keys.

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
            display-name = "HomeRow Left";
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
            display-name = "HomeRow Right";
        };

        mtt: mod_tap_tap_prio {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;

            display-name = "Mod-Tap Tap-Prio";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        //      <----KEY---->  <----KEY----->  <----KEY---->  <----KEY---->  <----KEY----->  <----KEY----> ||||| <----KEY---->  <----KEY---->  <----KEY---->  <-----KEY----->  <-----KEY------>  <----KEY---->
        //                                                                                                 |||||
        base {
            display-name = "BASE";
            bindings = <
                &kp ESC        &kp Q           &kp W          &kp E          &kp R           &kp T               &kp Y          &kp U          &kp I          &kp O            &kp P             &kp LGUI
                &kp LCTRL      &hml LSHFT A    &hml LCTRL S   &hml LALT D    &hml LGUI F     &kp G               &kp H          &hmr RGUI J    &hmr RALT K    &hmr RCTRL L     &hmr RSHIFT SEMI  &kp SQT
                &kp LSHFT      &kp Z           &mtt K_CUT X   &mtt K_COPY C  &mtt K_PASTE V  &mtt ESC B          &kp N          &kp M          &kp COMMA      &kp DOT          &kp FSLH          &kp RALT
                                                              &kp TAB        &mo 1           &kp BSPC            &kp SPACE      &mo 2          &kp RET
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
                &trans         &kp N1          &kp N2         &kp N3         &kp N4          &kp N5              &kp N6         &kp N7         &kp N8         &kp N9           &kp N0            &trans
                &trans         &bt BT_SEL 0    &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3    &bt BT_SEL 4        &kp LEFT       &kp DOWN       &kp UP         &kp RIGHT        &trans            &trans
                &trans         &studio_unlock  &trans         &trans         &trans          &bt BT_CLR          &trans         &trans         &trans         &trans           &trans            &trans
                                                              &trans         &trans          &trans              &trans         &trans         &trans
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &trans         &kp EXCL        &kp AT         &kp HASH       &kp DLLR        &kp PRCNT           &kp CARET      &kp AMPS       &kp STAR       &kp LPAR         &kp RPAR          &trans
                &trans         &kp MINUS       &kp UNDER      &kp PLUS       &kp EQUAL       &trans              &kp LBRC       &kp LBKT       &kp LPAR       &kp RPAR         &kp RBKT          &kp RBRC
                &trans         &trans          &kp BSLH       &kp PIPE       &kp FSLH        &trans              &trans         &kp GRAVE      &kp TILDE      &trans           &trans            &trans
                                                              &trans         &trans          &trans              &trans         &trans         &trans
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
                &trans         &none           &kp F1         &kp F2         &kp F3          &kp F4              &kp C_VOL_DN   &kp C_MUTE     &kp C_VOL_UP   &kp PAUSE_BREAK  &kp PSCRN         &kp SLCK
                &trans         &none           &kp F5         &kp F6         &kp F7          &kp F8              &kp HOME       &kp PG_DN      &kp PG_UP      &kp END          &kp DEL           &kp INS
                &trans         &none           &kp F9         &kp F10        &kp F11         &kp F12             &trans         &trans         &trans         &trans           &trans            &trans
                                                              &trans         &trans          &trans              &trans         &trans         &trans
            >;
        };

        mouse {
            display-name = "MOU";
            bindings = <
                &trans         &trans          &trans         &trans         &trans          &trans              &trans         &trans         &trans         &trans           &trans            &trans
                &trans         &trans          &trans         &trans         &trans          &trans              &trans         &trans         &trans         &trans           &trans            &trans
                &trans         &trans          &trans         &trans         &trans          &trans              &trans         &trans         &trans         &trans           &trans            &trans
                                                              &mkp MCLK      &mkp LCLK       &mkp RCLK           &mkp LCLK      &mkp RCLK      &mkp MCLK
            >;
        };

        extra_2 {
                status = "reserved";
        };

        extra_3 {
                status = "reserved";
        };
    };
};
